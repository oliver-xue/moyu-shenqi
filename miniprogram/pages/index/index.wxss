.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 28rpx 60rpx;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.topbar-left {
    display: flex;
    flex-direction: column;
}

.date {
    font-size: 30rpx;
    font-weight: 600;
}

.shift-range {
    margin-top: 6rpx;
    color: #5e7168;
    font-size: 22rpx;
}

.badge {
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    background: #e0f3eb;
    color: #0e7c72;
    font-size: 24rpx;
}

.badge-RESTING { background: #ffeccd; color: #8a5710; }
.badge-OFF_WORK { background: #e2e9e4; color: #4a5f57; }
.badge-OVERTIME { background: #ffe4df; color: #a3412f; }
.badge-DAY_OFF { background: #e9e5f8; color: #4f56a8; }
.badge-UNINITIALIZED { background: #e2e9e4; color: #4a5f57; }

.notice {
    margin-bottom: 20rpx;
    padding: 16rpx 20rpx;
    border-radius: 999rpx;
    background: #fff0d8;
    color: #7a5312;
    font-size: 22rpx;
}

.main-card {
    background: #ffffff;
}

.sub-row {
    display: flex;
    justify-content: space-between;
    margin: 4rpx 0 20rpx;
    color: #374a43;
    font-size: 24rpx;
}

.progress {
    display: block;
    width: 100%;
}

.money-card {
    background: #0e7c72;
    border-radius: 44rpx;
}

.money-card .card-label { color: #e4f6f0; }
.money-card .hint { color: #d5f0e7; }

.money-line {
    display: flex;
    align-items: baseline;
    margin: 8rpx 0 10rpx;
}

.cny {
    margin-right: 12rpx;
    color: #eafaf5;
    font-size: 40rpx;
}

.money-number {
    color: #ffffff;
    font-size: 84rpx;
}

.sub-line {
    display: block;
    color: #eafaf5;
    font-size: 24rpx;
}

.status-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24rpx;
    padding: 28rpx 32rpx;
    border-radius: 36rpx;
    border: 2rpx solid #bcdccd;
    background: #eaf5f0;
    text-align: center;
}

.status-copy {
    display: block;
    font-size: 30rpx;
    line-height: 1.6;
    text-align: center;
}

.status-tip {
    display: block;
    margin-top: 10rpx;
    color: #5e7168;
    font-size: 22rpx;
    text-align: center;
}

.overtime-button {
    margin: 20rpx auto 0;
    padding: 0 24rpx;
    background: #ffffff;
    color: #0e7c72;
    font-size: 24rpx;
    line-height: 64rpx;
}

.sw-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.sw-head-left {
    display: flex;
    flex-direction: column;
}

.sw-summary {
    margin-top: 8rpx;
    color: #374a43;
    font-size: 26rpx;
    font-variant-numeric: tabular-nums;
}

.sw-toggle {
    color: #0e7c72;
    font-size: 24rpx;
}

.sw-number {
    margin-top: 28rpx;
    font-size: 62rpx;
}

.tag-row {
    display: flex;
    gap: 16rpx;
    margin: 16rpx 0;
}

.tag {
    padding: 10rpx 28rpx;
    border-radius: 999rpx;
    background: #dfe9e3;
    color: #4a5f57;
    font-size: 24rpx;
}

.tag-on {
    background: #0e7c72;
    color: #ffffff;
}

.sw-btn {
    flex: 1;
    min-width: 130rpx;
    margin: 0;
    font-size: 26rpx;
}

.basis-row {
    display: flex;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #dfe9e3;
    font-size: 25rpx;
}

.basis-label { color: #5e7168; }
.basis-value { color: #14241f; text-align: right; max-width: 62%; }

.sheet-button { margin-top: 32rpx; }

.empty-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 140rpx 48rpx;
    text-align: center;
}

.empty-emoji { font-size: 100rpx; color: #9dc9b5; }
.empty-title { margin-top: 28rpx; font-size: 38rpx; font-weight: 600; }
.empty-desc { margin-top: 18rpx; color: #5e7168; font-size: 26rpx; line-height: 1.7; }
.empty-button { margin-top: 48rpx; width: 100%; }
