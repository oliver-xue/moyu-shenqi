.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 36rpx 28rpx 180rpx;
}

.stepbar {
    display: flex;
    gap: 12rpx;
}

.step-dot {
    flex: 1;
    height: 8rpx;
    border-radius: 999rpx;
    background: #cfe0d6;
}

.step-dot-on { background: #0e7c72; }

.step-count {
    display: block;
    margin-top: 20rpx;
    color: #5e7168;
    font-size: 22rpx;
}

.step-title {
    display: block;
    margin: 8rpx 0 32rpx;
    font-size: 42rpx;
    font-weight: 600;
}

.step-body { margin-bottom: 24rpx; }

.field-label {
    display: block;
    color: #374a43;
    font-size: 26rpx;
}

.salary-input {
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 112rpx;
    line-height: 112rpx;
    margin: 24rpx 0 10rpx;
    padding: 0 4rpx;
    border-bottom: 2rpx solid #a9c9bb;
    font-size: 72rpx;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
}

.ph { color: #90a69b; font-size: 48rpx; font-weight: 400; }

/* 休息制度二选一分段控件 */
.week-picker {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
}

.week-option {
    box-sizing: border-box;
    flex: 1;
    min-height: 150rpx;
    padding: 24rpx 20rpx;
    border: 2rpx solid #cfded6;
    border-radius: 28rpx;
    background: #ffffff;
}

.week-option-on {
    border-color: #0e7c72;
    background: #e0f3eb;
}

.week-option-title {
    display: block;
    color: #14241f;
    font-size: 34rpx;
    font-weight: 600;
}

.week-option-desc {
    display: block;
    margin-top: 8rpx;
    color: #5e7168;
    font-size: 22rpx;
    line-height: 1.5;
}

.privacy {
    margin-top: 24rpx;
    padding: 28rpx;
    border-radius: 30rpx;
    background: #dff0e8;
}

.privacy-title { display: block; color: #0e7c72; font-size: 26rpx; font-weight: 600; }
.privacy-text { display: block; margin-top: 10rpx; color: #2f6355; font-size: 24rpx; line-height: 1.7; }

/* 第 1 步：步骤标题与欢迎内容整体居中；白框栏目已移除 */
.page-welcome .step-count,
.page-welcome .step-title { text-align: center; }

.page-welcome .step-title { margin-bottom: 8rpx; }

.step-body-welcome {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 58vh;
    padding: 40rpx 24rpx 56rpx;
    text-align: center;
}

.welcome-icon {
    font-size: 150rpx;
    line-height: 1.2;
    color: #8fc4ae;
}

.welcome-title {
    display: block;
    max-width: 560rpx;
    margin: 32rpx 0 18rpx;
    font-size: 38rpx;
    font-weight: 600;
    line-height: 1.55;
    text-align: center;
}

.welcome-desc {
    display: block;
    max-width: 540rpx;
    color: #4a5f57;
    font-size: 27rpx;
    line-height: 1.85;
    text-align: center;
}

.time-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 0;
}

.time-label { color: #5e7168; font-size: 26rpx; }
.time-value { font-size: 44rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.time-edit { color: #0e7c72; font-size: 24rpx; }

.divider { height: 2rpx; background: #dfe9e3; }

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-top: 12rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #dfe9e3;
    color: #374a43;
    font-size: 24rpx;
}

.cross-tag { color: #8a5710; }

.rest-head { display: flex; justify-content: space-between; align-items: center; }
.rest-count { color: #5e7168; font-size: 22rpx; }
.rest-empty { padding: 36rpx 0; color: #82948b; font-size: 25rpx; text-align: center; }

.rest-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-bottom: 2rpx solid #dfe9e3;
}

.rest-time { font-size: 30rpx; font-variant-numeric: tabular-nums; }
.rest-edit { color: #0e7c72; font-size: 24rpx; }

.add-button {
    margin-top: 24rpx;
    background: #e0f3eb;
    color: #0e7c72;
    font-size: 27rpx;
}

.add-button-off { background: #dfe9e3; color: #82948b; }

.confirm-row {
    display: flex;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #dfe9e3;
    color: #374a43;
    font-size: 25rpx;
}

.confirm-rest { max-width: 60%; text-align: right; }
.result-card { background: #dff0e8; }
.result-card .field-label { color: #0e7c72; font-weight: 600; }

.result-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22rpx 0 8rpx;
    color: #0e7c72;
    font-size: 27rpx;
}

.result-value { font-size: 38rpx; font-weight: 600; }

.footer-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 16rpx;
    padding: 20rpx 28rpx 40rpx;
    background: #ffffff;
    border-top: 2rpx solid #dfe9e3;
}

.footer-btn { flex: 1; margin: 0; }



.picker-mask { z-index: 200; }

.picker-current {
    display: block;
    margin: 8rpx 0 16rpx;
    font-size: 56rpx;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
}

.picker { height: 320rpx; }

.picker-item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80rpx;
    font-size: 34rpx;
    font-variant-numeric: tabular-nums;
}

.fine-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 20rpx 0;
}

.fine-tip { color: #5e7168; font-size: 22rpx; }
.sheet-button { margin-top: 12rpx; }
