page {
    min-height: 100%;
    background: #eef3f0;
    color: #14241f;
    font-family: "Yuanti SC", "YouYuan", "幼圆", "PingFang SC", "Hiragino Sans GB", -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.7;
    letter-spacing: 0.4rpx;
}

button {
    border-radius: 999rpx;
    font-size: 28rpx;
}

button::after {
    border: none;
}

.card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 36rpx;
    background: #ffffff;
}

.card-label {
    color: #5e7168;
    font-size: 26rpx;
}

.big-number {
    display: block;
    margin: 16rpx 0;
    font-size: 76rpx;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 2rpx;
    font-variant-numeric: tabular-nums;
    font-family: "SF Pro Rounded", "DIN Alternate", "Yuanti SC", -apple-system, sans-serif;
}

.hint {
    display: block;
    margin-top: 14rpx;
    color: #5e7168;
    font-size: 22rpx;
    line-height: 1.6;
}

.error {
    display: block;
    margin-top: 12rpx;
    color: #c0392b;
    font-size: 24rpx;
}

.primary-button {
    background: #0e7c72;
    color: #ffffff;
    font-size: 28rpx;
}

.ghost-button {
    background: #dfe9e3;
    color: #374a43;
}

.mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(20, 32, 40, 0.45);
}

.sheet {
    box-sizing: border-box;
    width: 100%;
    max-height: 86vh;
    overflow-y: auto;
    padding: 40rpx 32rpx 60rpx;
    border-radius: 36rpx 36rpx 0 0;
    background: #ffffff;
}

.sheet-title {
    display: block;
    margin-bottom: 24rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-top: 24rpx;
}

.btn-row button {
    flex: 1;
    min-width: 160rpx;
    margin: 0;
}

/* 全局：按下快速缩小，松开弹性回弹（首页与引导页共用） */
.tap-bounce { transition: transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1); }
.tap-bounce.btn-press {
    transform: scale(0.94);
    transition: transform 90ms ease-in;
}
